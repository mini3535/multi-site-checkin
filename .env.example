# setup.sh 会自动生成实际 .env；此文件仅说明配置项。
# 初始管理员密码为 12 至 256 字符。不要使用示例密码。
# 首次启动后密码哈希保存在数据卷；后台修改后此初始值不再用于登录。
AUTOSIGN_ADMIN_PASSWORD=
# 必须是随机 32 字节经 URL-safe Base64 编码得到的 Fernet 密钥。
# 已有数据后必须保留原密钥，不能重新生成。
AUTOSIGN_SECRET_KEY=
# HTTP 与浏览器任务默认只允许公网目标；仅测试或自己的内网网站才设 true。
AUTOSIGN_ALLOW_PRIVATE_TARGETS=false
# 由 setup.sh 按访问方式设置：HTTP/SSH 为 false，域名 HTTPS 为 true。
AUTOSIGN_COOKIE_SECURE=false
AUTOSIGN_TIMEZONE=Asia/Shanghai
# Docker 镜像已安装 Chromium；推荐用浏览器扩展连接账号，会话加密保存。
# 不要把网站 Cookie 或会话 JSON 填在这里。
BIND_ADDRESS=127.0.0.1
PORT=8080

# 使用 setup.sh --domain 域名 / --no-domain 服务器IP / --private 配置以下项目。
AUTOSIGN_ACCESS_MODE=private
AUTOSIGN_DOMAIN=
AUTOSIGN_PUBLIC_HOST=
AUTOSIGN_EXTERNAL_PROXY=false
COMPOSE_PROFILES=
