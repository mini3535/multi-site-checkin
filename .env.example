# setup.sh 会自动生成实际 .env；此文件仅说明配置项。
# 管理员密码至少 12 个字符。不要使用示例密码。
AUTOSIGN_ADMIN_PASSWORD=
# 必须是随机 32 字节经 URL-safe Base64 编码得到的 Fernet 密钥。
# 已有数据后必须保留原密钥，不能重新生成。
AUTOSIGN_SECRET_KEY=
# HTTP 与浏览器任务默认只允许公网目标；仅测试或自己的内网网站才设 true。
AUTOSIGN_ALLOW_PRIVATE_TARGETS=false
# 通过 SSH 隧道访问 HTTP 时为 false；自配 HTTPS 反代后可设 true。
AUTOSIGN_COOKIE_SECURE=false
AUTOSIGN_TIMEZONE=Asia/Shanghai
# Docker 镜像已安装 Chromium，浏览器会话通过管理页导入并加密保存。
# 不要把网站 Cookie 或会话 JSON 填在这里。
BIND_ADDRESS=127.0.0.1
PORT=8080
